{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "battery", "tray"],
    "sway/workspaces": {
        "format": "{name}"
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "pulseaudio": {
        "format": "{volume}%",
        "format-muted": "Muted",
        "on-click": "pavucontrol"
    },
    "battery": {
        "format": "{capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },
    "tray": {
        "spacing": 10
    }
}
